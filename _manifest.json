{
  "manifest_version": 2,
  "id": "khiqwq.daily_analysis",
  "version": "2.2.0",
  "name": "每日分析插件",
  "description": "智能分析 QQ 群聊天记录并生成精美图片总结。支持群聊整体总结、个人总结、智能群友称号、群聊金句、炫压抑评级、24小时活跃轨迹与每日定时自动总结。已适配 MaiBot 1.0 / maibot_sdk 2.x，使用宿主内置 HTML 渲染能力，无需自行安装浏览器依赖。",
  "author": {
    "name": "风花叶",
    "url": "https://github.com/khiqwq"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/khiqwq/Maibot_daily_analysis",
    "homepage": "https://github.com/khiqwq/Maibot_daily_analysis",
    "documentation": "https://docs.mai-mai.org/develop/plugin_develop/",
    "issues": "https://github.com/khiqwq/Maibot_daily_analysis/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jinja2",
      "version_spec": ">=3.1.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "llm.generate",
    "config.get",
    "message.get_by_time_in_chat",
    "chat.get_group_streams",
    "render.html2png",
    "maisaka.context.append"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
